<%# ---------- HERO ---------- %>
<section class="hero">
  <div class="hero__text">
    <p class="eyebrow"><%= t("site.tagline") %> · <%= t("site.location") %></p>
    <h1><%= t(".hero.title") %></h1>
    <p class="lead"><%= t(".hero.lead") %></p>
    <div class="hero__actions">
      <%= link_to t(".hero.cta_whatsapp"),
                  whatsapp_url,
                  class: "btn btn--primary",
                  target: "_blank",
                  rel: "noopener" %>
      <a href="#services" class="btn btn--ghost"><%= t(".hero.cta_services") %></a>
    </div>
    <ul class="stack">
      <% t(".hero.stack").each do |tech| %>
        <li><%= tech %></li>
      <% end %>
    </ul>
  </div>
  <%= image_placeholder(t(".hero.image"), css_class: "img-placeholder--portrait") %>
</section>

<%# ---------- ABOUT ---------- %>
<section id="about" class="section split">
  <div>
    <h2><%= t(".about.title") %></h2>
    <% t(".about.paragraphs").each do |paragraph| %>
      <p><%= paragraph %></p>
    <% end %>
  </div>
  <%= image_placeholder(t(".about.image"), css_class: "img-placeholder--tall") %>
</section>

<%# ---------- SERVICES ---------- %>
<section id="services" class="section section--alt">
  <h2><%= t(".services.title") %></h2>
  <p class="section__intro"><%= t(".services.intro") %></p>

  <div class="cards">
    <% t(".services.cards").each do |card| %>
      <article class="card">
        <%= image_placeholder(card[:icon]) %>
        <h3><%= card[:title] %></h3>
        <p><%= card[:text] %></p>
      </article>
    <% end %>
  </div>
</section>

<%# ---------- EXPERIENCE ---------- %>
<section id="experience" class="section">
  <h2><%= t(".experience.title") %></h2>
  <ol class="timeline">
    <% t(".experience.jobs").each do |job| %>
      <li class="timeline__item">
        <span class="timeline__date"><%= job[:date] %></span>
        <h3><%= job[:title] %></h3>
        <p class="timeline__meta"><%= job[:meta] %></p>
        <p><%= job[:text] %></p>
      </li>
    <% end %>
  </ol>

  <div class="education">
    <h3><%= t(".experience.education.title") %></h3>
    <ul>
      <% t(".experience.education.items").each do |item| %>
        <li><strong><%= item[:degree] %></strong> — <%= item[:school] %></li>
      <% end %>
    </ul>
    <p class="timeline__meta"><%= t(".experience.education.languages") %></p>
  </div>
</section>

<%# ---------- CONTACT ---------- %>
<section id="contact" class="section contact">
  <h2><%= t(".contact.title") %></h2>
  <p class="lead"><%= t(".contact.lead") %></p>
  <div class="contact__actions">
    <%= link_to whatsapp_url, class: "btn btn--primary btn--large", target: "_blank", rel: "noopener" do %>
      <%= t(".contact.whatsapp") %> · <%= whatsapp_number_display %>
    <% end %>
    <%= mail_to contact_email, contact_email, class: "btn btn--ghost btn--large" %>
  </div>
  <p class="contact__note">
    <%= t(".contact.note_html", linkedin: link_to("LinkedIn", site.linkedin_url, target: "_blank", rel: "noopener")) %>
  </p>
</section>
