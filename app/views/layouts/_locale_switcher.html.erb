<%# Language dropdown. Pure HTML (<details>), no JavaScript needed. %>
<details class="dropdown">
  <summary class="dropdown__toggle" aria-label="<%= t("layout.lang.label") %>">
    <%= t("layout.lang.flags.#{I18n.locale}") %>
    <span class="dropdown__caret" aria-hidden="true">▾</span>
  </summary>
  <ul class="dropdown__menu">
    <% I18n.available_locales.each do |locale| %>
      <li>
        <%= link_to url_for(locale: locale),
                    class: "dropdown__option #{"dropdown__option--active" if locale == I18n.locale}",
                    hreflang: locale,
                    lang: locale do %>
          <%= t("layout.lang.flags.#{locale}") %> <%= t("layout.lang.names.#{locale}") %>
        <% end %>
      </li>
    <% end %>
  </ul>
</details>
